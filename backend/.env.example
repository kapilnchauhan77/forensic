# Application
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forensic_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/forensic_db

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./storage

# S3 (if USE_LOCAL_STORAGE=false)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ORIGINALS=fingerprint-originals
S3_BUCKET_ENHANCED=fingerprint-enhanced
S3_REGION=us-east-1

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
